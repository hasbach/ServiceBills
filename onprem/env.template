# ServiceBills on-prem .env template. The installer generates the real file at
# C:\ProgramData\ServiceBills\.env and never overwrites it once present.

# Secret used to sign login tokens (random, 64+ hex chars).
JWT_SECRET_KEY=__GENERATE_RANDOM_HEX__
# Fernet key for encrypting stored credentials (urlsafe base64 of 32 random bytes).
FERNET_KEY=__GENERATE_FERNET_KEY__
# Password for the bundled Postgres database (random, URL-safe characters only).
POSTGRES_PASSWORD=__GENERATE_RANDOM_PASSWORD__
# Lower-case hex SHA-256 of HKLM\SOFTWARE\Microsoft\Cryptography\MachineGuid (binds the license).
MACHINE_ID=__MACHINE_ID_SHA256__
# IANA timezone of the business, e.g. Asia/Beirut.
TZ=UTC
# URL users open in the browser: http://<lan-ip>:8000
APP_BASE_URL=http://192.168.1.10:8000
# Image tag to run (SemVer such as 1.2.3, or latest).
IMAGE_TAG=latest
